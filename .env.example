# Copy to .env (locale) o configura su Vercel Dashboard → Settings → Environment Variables
# Le var POSTGRES_* vengono iniettate automaticamente da Vercel quando colleghi un Postgres.

DATABASE_URL=

# Password per pagina /admin (Basic Auth). Genera robusta es. con: openssl rand -base64 24
ADMIN_PASSWORD=cambia-questa-password

# Salt per hash IP (anti-spam senza salvare IP in chiaro). Genera con: openssl rand -hex 32
IP_HASH_SALT=cambia-questo-salt
