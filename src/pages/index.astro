---
const SITE_URL = 'https://freighter.online';
const TITLE = 'The Freighter — Il prezzo giusto per ogni carico | TMS trasporti Italia';
const DESCRIPTION = "TMS, prezzi calcolati sullo storico delle rotte e rete vettori in un'unica piattaforma per il trasporto su gomma in Italia. Beta privata.";
const OG_IMAGE = `${SITE_URL}/og-image-v5.png`;
const CANONICAL = SITE_URL + '/';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'The Freighter',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/logo.png`,
    width: 512,
    height: 512,
  },
  image: OG_IMAGE,
  description: DESCRIPTION,
  areaServed: 'IT',
  slogan: 'Il prezzo giusto per ogni carico, prima che squilli il telefono.',
  knowsLanguage: 'it-IT',
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: SITE_URL,
  name: 'The Freighter',
  inLanguage: 'it-IT',
};
---
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="canonical" href={CANONICAL} />

<title>{TITLE}</title>
<meta name="description" content={DESCRIPTION} />
<meta name="robots" content="index, follow" />
<meta name="author" content="The Freighter" />
<meta name="theme-color" content="#F4F1E7" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content="The Freighter" />
<meta property="og:url" content={CANONICAL} />
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESCRIPTION} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="The Freighter — il prezzo giusto per ogni carico, prima che squilli il telefono" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={TITLE} />
<meta name="twitter:description" content={DESCRIPTION} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content="The Freighter — il prezzo giusto per ogni carico, prima che squilli il telefono" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/logo.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

<link rel="stylesheet" href="/styles/landing.css" />

<!-- Accent randomizer: pick one of the 4 design accents on every page load.
     Runs synchronously in <head> so the first paint already uses the random
     accent (inline style on <html> overrides the :root default → no flash). -->
<script is:inline>
  (function () {
    var ACCENTS = {
      '#FF4A1C': '#F4F1E7', // vermillion → light text
      '#FFD400': '#0B0B0B', // hazard yellow → dark text
      '#C6F000': '#0B0B0B', // acid lime → dark text
      '#2D43FF': '#F4F1E7'  // electric cobalt → light text
    };
    var keys = Object.keys(ACCENTS);
    var acc = keys[Math.floor(Math.random() * keys.length)];
    var root = document.documentElement;
    root.style.setProperty('--acc', acc);
    root.style.setProperty('--on-acc', ACCENTS[acc]);
  })();
</script>
</head>
<body>

<!-- ===================== NAV ===================== -->
<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="The Freighter — torna all'inizio">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">The Freighter</span>
    </a>
    <nav class="nav-links" aria-label="Navigazione principale">
      <a href="#problema">Problema</a>
      <a href="#network">La rete</a>
    </nav>
    <a href="#beta" class="nav-cta"><span class="cta-long">Entra nella </span>waiting list <span class="arr">→</span></a>
  </div>
</header>

<main id="top">

<!-- ===================== HERO ===================== -->
<section class="hero dark">
  <div class="container">
    <h1 class="hero-title">
      <span class="ln">Il prezzo</span>
      <span class="ln"><span class="word x3d">giusto</span>,</span>
      <span class="ln">prima che</span>
      <span class="ln">squilli</span>
      <span class="ln">il telefono.</span>
    </h1>

    <div class="hero-sub">
      <p class="lead">TMS, prezzi calcolati sullo storico delle tue rotte e rete vettori in un'unica piattaforma. Sai quanto chiedere, chi chiamare e quanto ci stai guadagnando.</p>
      <div class="hero-cta">
        <form class="field" id="beta" data-form="hero" novalidate>
          <input type="email" name="email" placeholder="la-tua-email@azienda.it" autocomplete="email" required />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <button type="submit"><span class="lbl">Entra nella waiting list</span> <span class="arr">→</span></button>
        </form>
        <div class="hero-fineprint">
          <span><span class="sq"></span> Nessuna carta</span>
          <span><span class="sq"></span> Risposta in 48h</span>
          <span><span class="sq"></span> Niente spam</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== PROBLEMA ===================== -->
<section id="problema">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker"><span class="n">/01</span> Il problema</span>
      <h2>Il brokerage va avanti a<br/><span class="hl">telefono</span> e a <span class="hl">sentimento.</span></h2>
      <p class="lead">Tre problemi che chi fa questo mestiere conosce bene.</p>
    </div>
    <div class="cards-3 reveal">
      <article class="card">
        <span class="idx">Problema 01</span>
        <h3>Pricing a <span class="hl">sentimento.</span></h3>
        <p>"Quanto chiediamo per Milano - Palermo questo mese?" Oggi la risposta dipende da chi è in ufficio.</p>
        <p class="quote">"Lo facciamo sempre a 1.300, no?"<br/>"Dipende. Da chi guida e da che giorno è."</p>
      </article>
      <article class="card">
        <span class="idx">Problema 02</span>
        <h3>Vettori per <span class="hl">abitudine.</span></h3>
        <p>Si chiama sempre lo stesso, anche quando per quella tratta non è la scelta giusta.</p>
        <p class="quote">"Chiama Marco, lui ha il furgone giusto."<br/>"Marco è in ferie da due settimane."</p>
      </article>
      <article class="card">
        <span class="idx">Problema 03</span>
        <h3>Margini che <span class="hl">crollano.</span></h3>
        <p>Senza storico ogni trattativa riparte da zero. E nessuno sa dire quanto rende davvero una rotta.</p>
        <p class="quote">"Questa l'abbiamo chiusa in attivo?"<br/>"Domani, devo guardare i fogli."</p>
      </article>
    </div>
  </div>
</section>

<!-- ===================== LIVE NETWORK (3D map) ===================== -->
<section id="network" class="dark live">
  <div class="container">
    <div class="live-head reveal">
      <div>
        <span class="kicker"><span class="n">/02</span> La rete</span>
        <h2>Le tue tratte,<br/>su una <span class="hl">mappa.</span></h2>
      </div>
      <div class="live-readout">
        <span>Tratta · esempio</span>
        <b data-route>MI → RM · 574 KM</b>
      </div>
    </div>

    <div class="map-stage reveal">
      <span class="map-tag tl">Anteprima · Italia</span>
      <div class="map-plane">
        <svg class="map-svg" viewBox="0 0 320 520" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <!-- ground grid -->
          <g class="grid">
            <line class="grid-l" x1="0" y1="40" x2="320" y2="40"/>
            <line class="grid-l" x1="0" y1="120" x2="320" y2="120"/>
            <line class="grid-l" x1="0" y1="200" x2="320" y2="200"/>
            <line class="grid-l" x1="0" y1="280" x2="320" y2="280"/>
            <line class="grid-l" x1="0" y1="360" x2="320" y2="360"/>
            <line class="grid-l" x1="0" y1="440" x2="320" y2="440"/>
            <line class="grid-l" x1="40" y1="0" x2="40" y2="520"/>
            <line class="grid-l" x1="120" y1="0" x2="120" y2="520"/>
            <line class="grid-l" x1="200" y1="0" x2="200" y2="520"/>
            <line class="grid-l" x1="280" y1="0" x2="280" y2="520"/>
          </g>

          <!-- rings around Roma hub -->
          <circle class="ring" cx="186" cy="262" r="78"/>
          <circle class="ring" cx="186" cy="262" r="134"/>

          <!-- pulse rings -->
          <circle class="pulse" cx="186" cy="262" r="6" stroke-width="1.2">
            <animate attributeName="r" values="4;48" dur="3s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0" dur="3s" repeatCount="indefinite"/>
          </circle>
          <circle class="pulse" cx="120" cy="94" r="6" stroke-width="1.2">
            <animate attributeName="r" values="4;36" dur="3.4s" begin="0.6s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.7;0" dur="3.4s" begin="0.6s" repeatCount="indefinite"/>
          </circle>

          <!-- dim arc -->
          <path class="arc-dim" d="M120,94 C 220,150 320,200 298,322"/>

          <!-- active arcs (ships travel along these) -->
          <path class="arc" id="arc1" d="M120,94 C 170,140 200,180 186,262"/>
          <path class="arc" id="arc2" d="M75,102 C 130,180 230,210 270,300"/>
          <path class="arc" id="arc3" d="M213,102 C 280,220 250,360 180,440"/>
          <path class="arc" id="arc4" d="M158,138 C 220,180 230,240 218,308"/>

          <!-- cities -->
          <g>
            <circle class="city" cx="75" cy="78" r="2"/>
            <circle class="city hub" cx="75" cy="102" r="3"/>
            <circle class="city hub" cx="120" cy="94" r="3.6"/>
            <circle class="city" cx="135" cy="92" r="2"/>
            <circle class="city" cx="155" cy="96" r="2"/>
            <circle class="city hub" cx="213" cy="102" r="3"/>
            <circle class="city" cx="232" cy="104" r="2"/>
            <circle class="city" cx="110" cy="135" r="2.4"/>
            <circle class="city hub" cx="158" cy="138" r="3"/>
            <circle class="city" cx="168" cy="178" r="2.4"/>
            <circle class="city" cx="218" cy="200" r="2"/>
            <circle class="city" cx="218" cy="238" r="2"/>
            <circle class="city hub" cx="186" cy="262" r="4.4"/>
            <circle class="city hub" cx="218" cy="308" r="3"/>
            <circle class="city hub" cx="270" cy="300" r="3"/>
            <circle class="city" cx="298" cy="322" r="2.4"/>
            <circle class="city" cx="245" cy="362" r="2"/>
            <circle class="city" cx="244" cy="402" r="2"/>
            <circle class="city hub" cx="180" cy="440" r="3"/>
            <circle class="city" cx="232" cy="458" r="2"/>
            <circle class="city" cx="108" cy="438" r="2.4"/>
          </g>

          <!-- labels -->
          <text class="clabel" x="126" y="91">Milano</text>
          <text class="clabel" x="193" y="261">Roma</text>
          <text class="clabel" x="224" y="307">Napoli</text>
          <text class="clabel" x="276" y="299">Bari</text>
          <text class="clabel" x="150" y="448">Palermo</text>
          <text class="clabel" x="70" y="101" text-anchor="end">Torino</text>
          <text class="clabel" x="219" y="111">Venezia</text>
          <text class="clabel" x="153" y="148" text-anchor="end">Bologna</text>

          <!-- traveling ships injected here -->
          <g id="ship-layer"></g>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ===================== HONESTY ===================== -->
<section>
  <div class="container">
    <div class="honesty reveal">
      <span class="stamp">On the record</span>
      <h2>Siamo onesti su<br/>cosa <span class="hl">non siamo.</span></h2>
      <div class="honesty-list">
        <div class="honesty-item">
          <span class="h-tag">Non vendiamo</span>
          <p><span class="strike">Tracking GPS</span>Richiede hardware sui camion. Non è il nostro mestiere.</p>
        </div>
        <div class="honesty-item">
          <span class="h-tag">Non promettiamo</span>
          <p><span class="strike">AI magica</span>Statistiche sui tuoi dati reali, e vedi sempre da dove esce il numero.</p>
        </div>
        <div class="honesty-item">
          <span class="h-tag">Non sostituiamo</span>
          <p><span class="strike">Il tuo giudizio</span>Lo rendiamo più veloce e più informato. Le decisioni restano tue.</p>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<script is:inline src="/scripts/freighter.js"></script>

</body>
</html>
